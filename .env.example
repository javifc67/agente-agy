# ====================================================================
# Configuración de AgyAgent (Impulsado por Antigravity / agy)
# ====================================================================

# 1. Token de tu bot de Telegram (obtenido a través de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_de_botfather_aqui

# 2. Tu ID numérico de usuario en Telegram (para que SOLO TÚ puedas darle órdenes al bot)
# Si lo dejas en 0 al principio, el bot te dirá tu ID en Telegram al escribirle /start o /id
TELEGRAM_ALLOWED_USER_ID=0

# 3. Heartbeat en segundo plano (Always-On)
ENABLE_HEARTBEAT=true
HEARTBEAT_MINUTES=15

# 4. Ruta del binario de agy (opcional, por defecto detecta automáticamente 'agy')
# AGY_BIN=/home/usuario/.local/bin/agy
